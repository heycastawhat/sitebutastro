---
import Layout from "../layouts/Layout.astro";

const apiKey = import.meta.env.LASTFM_API_KEY;
const githubToken = import.meta.env.GITHUB_TOKEN;
const username = "castawhat";
const githubUsername = "heycastawhat";

interface TrackImage {
    size: string;
    "#text": string;
}

interface Track {
    name: string;
    artist: {
        "#text": string;
    };
    album: {
        "#text": string;
    };
    image: TrackImage[];
    "@attr"?: {
        nowplaying: string;
    };
    date?: {
        "#text": string;
    };
}

let tracks: Track[] = [];
let error: string | null = null;

try {
    const url = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${username}&api_key=${apiKey}&format=json&limit=4`;
    const response = await fetch(url);
    const data = await response.json();

    if (data.recenttracks && data.recenttracks.track) {
        tracks = Array.isArray(data.recenttracks.track)
            ? data.recenttracks.track.slice(0, 4)
            : [data.recenttracks.track];
    }
} catch (e) {
    error = "Failed to fetch Last.fm data";
    console.error(error, e);
}

interface GitHubCommit {
    sha: string;
    commit: {
        message: string;
        author: {
            date: string;
        };
    };
    html_url: string;
}

interface GitHubRepo {
    name: string;
    html_url: string;
    full_name: string;
}

interface RepoCommitCount {
    name: string;
    url: string;
    commits: number;
}

let lastCommit: { repo: string; message: string; date: string; url: string } | null = null;
let topRepos: RepoCommitCount[] = [];
let githubError: string | null = null;

const ghHeaders: Record<string, string> = {
    Accept: "application/vnd.github+json",
};
if (githubToken) {
    ghHeaders.Authorization = `Bearer ${githubToken}`;
}

try {
    // Fetch most recently pushed repos
    const reposRes = await fetch(
        `https://api.github.com/users/${githubUsername}/repos?per_page=20&sort=pushed`,
        { headers: ghHeaders },
    );
    const repos: GitHubRepo[] = await reposRes.json();

    // Fetch latest commit + commit counts in a single parallel batch
    const since = new Date();
    since.setDate(since.getDate() - 90);
    const sinceISO = since.toISOString();

    const repoResults = await Promise.all(
        repos.slice(0, 10).map(async (repo) => {
            try {
                const res = await fetch(
                    `https://api.github.com/repos/${githubUsername}/${repo.name}/commits?author=${githubUsername}&since=${sinceISO}&per_page=100`,
                    { headers: ghHeaders },
                );
                const data = await res.json();
                const commits = Array.isArray(data) ? data : [];
                return {
                    name: repo.name,
                    url: repo.html_url,
                    count: commits.length,
                    latest: commits.length > 0 ? commits[0] as GitHubCommit : null,
                };
            } catch (e) {
                return { name: repo.name, url: repo.html_url, count: 0, latest: null };
            }
        }),
    );

    // Find latest commit across all repos
    const withCommits = repoResults.filter((r) => r.latest !== null);
    if (withCommits.length > 0) {
        const mostRecent = withCommits.sort(
            (a, b) => new Date(b.latest!.commit.author.date).getTime() - new Date(a.latest!.commit.author.date).getTime()
        )[0];
        lastCommit = {
            repo: mostRecent.name,
            message: mostRecent.latest!.commit.message.split("\n")[0],
            date: new Date(mostRecent.latest!.commit.author.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                hour: "2-digit",
                minute: "2-digit",
            }),
            url: mostRecent.latest!.html_url,
        };
    }

    topRepos = repoResults
        .filter((r) => r.count > 0)
        .sort((a, b) => b.count - a.count)
        .slice(0, 5)
        .map((r) => ({ name: r.name, url: r.url, commits: r.count }));
} catch (e) {
    githubError = "Failed to fetch GitHub data";
    console.error(githubError, e);
}
---

<Layout
    title="Stats — Site V4"
    footerType="default"
    footerComment="music and setting"
    commentLink="https://youtu.be/taNqWqtVWqA?si=JObsn2Pt5VLGOAlg&t=269"
>
    <div class="stats-container">
        <h1>What I'm Listening To</h1>

        {error && <p class="error">{error}</p>}

        <div class="tracks-grid">
            {
                tracks.map((track) => {
                    const isNowPlaying = track["@attr"]?.nowplaying === "true";
                    const largeImage = track.image.find(
                        (img) =>
                            img.size === "large" || img.size === "extralarge",
                    );
                    const imageUrl = largeImage?.["#text"] || "";

                    return (
                        <div
                            class={`track-card ${isNowPlaying ? "now-playing" : ""}`}
                        >
                            {imageUrl && (
                                <img
                                    src={imageUrl}
                                    alt={track.name}
                                    class="track-image"
                                />
                            )}
                            <div class="track-info">
                                <h3 class="track-name">{track.name}</h3>
                                <p class="artist-name">
                                    {track.artist["#text"]}
                                </p>
                                <p class="album-name">{track.album["#text"]}</p>
                                {isNowPlaying && (
                                    <span class="now-playing-badge">
                                        Now Playing
                                    </span>
                                )}
                                {track.date && (
                                    <p class="play-date">
                                        {track.date["#text"]}
                                    </p>
                                )}
                            </div>
                        </div>
                    );
                })
            }
        </div>

        <h1>GitHub Activity</h1>

        {githubError && <p class="error">{githubError}</p>}

        {lastCommit && (
            <div class="github-section">
                <h2>Last Commit</h2>
                <div class="track-card">
                    <div class="track-info">
                        <h3 class="track-name">
                            <a href={lastCommit.url} target="_blank" rel="noopener noreferrer">
                                {lastCommit.message}
                            </a>
                        </h3>
                        <p class="artist-name">{lastCommit.repo}</p>
                        <p class="play-date">{lastCommit.date}</p>
                    </div>
                </div>
            </div>
        )}

        {topRepos.length > 0 && (
            <div class="github-section">
                <h2>Most Active Repos <span class="subtitle">(last 90 days)</span></h2>
                <div class="tracks-grid">
                    {topRepos.map((repo) => (
                        <div class="track-card">
                            <div class="track-info">
                                <h3 class="track-name">
                                    <a href={repo.url} target="_blank" rel="noopener noreferrer">
                                        {repo.name}
                                    </a>
                                </h3>
                                <p class="artist-name">{repo.commits} commits</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        )}
    </div>
</Layout>

<style>
    .stats-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    h1 {
        color: var(--ctp-text);
        margin-bottom: 2rem;
        font-size: 2rem;
    }

    .error {
        color: var(--ctp-red);
        padding: 1rem;
        background: var(--ctp-surface0);
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .tracks-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .track-card {
        background: var(--ctp-surface0);
        border-radius: 12px;
        padding: 1rem;
        transition: all 0.2s ease;
        border: 1px solid var(--ctp-surface1);
        display: flex;
        gap: 1rem;
    }

    .track-card:hover {
        border-color: var(--ctp-blue);
        transform: translateY(-2px);
    }

    .track-card.now-playing {
        border: 2px solid var(--ctp-blue);
        background: var(--ctp-surface0);
    }

    .track-image {
        width: 100px;
        height: 100px;
        border-radius: 8px;
        flex-shrink: 0;
    }

    .track-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .track-name {
        color: var(--ctp-text);
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .artist-name {
        color: var(--ctp-blue);
        margin: 0;
        font-size: 0.95rem;
    }

    .album-name {
        color: var(--ctp-subtext1);
        margin: 0;
        font-size: 0.85rem;
    }

    .play-date {
        color: var(--ctp-overlay1);
        margin: 0;
        font-size: 0.8rem;
    }

    .now-playing-badge {
        display: inline-block;
        background: var(--ctp-blue);
        color: var(--ctp-crust);
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 0.5rem;
        width: fit-content;
    }

    .github-section {
        margin-bottom: 2rem;
    }

    .github-section h2 {
        color: var(--ctp-text);
        font-size: 1.3rem;
        margin: 0 0 1rem;
    }

    .subtitle {
        color: var(--ctp-overlay1);
        font-size: 0.85rem;
        font-weight: normal;
    }

    .track-card a {
        color: var(--ctp-blue);
        text-decoration: none;
    }

    .track-card a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .tracks-grid {
            grid-template-columns: 1fr;
        }

        h1 {
            font-size: 1.5rem;
        }
    }
</style>
