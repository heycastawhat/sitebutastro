---
import Layout from '../layouts/Layout.astro';
import AdminWrapper from '../components/AdminWrapper';
---

<Layout>
  <main>
    <h1>Admin Panel</h1>
    <AdminWrapper client:only="react" />
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    color: var(--ctp-text);
  }

  h1 {
    color: var(--ctp-lavender);
    margin-bottom: 1.5rem;
  }
</style>
