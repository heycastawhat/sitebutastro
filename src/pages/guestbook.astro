---
import Layout from '../layouts/Layout.astro';
import GuestbookWrapper from '../components/GuestbookWrapper';
---

<Layout title="Guestbook" footerType="default" footerComment="you are one of those classic ones, traveling around this sun" commentLink="https://www.youtube.com/watch?v=f3bzqzspXPI">
  <main>
    <h1>Guestbook</h1>
    <p>Leave a message in the guestbook!</p>

    <!-- Wrap the interactive React app with the Convex provider using client:only to avoid SSR context errors -->
    <GuestbookWrapper client:only="react" />
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    color: var(--ctp-text);
  }

  h1 {
    color: var(--ctp-lavender);
    margin-bottom: 0.5rem;
  }

  p {
    margin-bottom: 2rem;
  }
</style>
