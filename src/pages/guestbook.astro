---
import Layout from '../layouts/Layout.astro';
import GuestbookApp from '../components/GuestbookApp';
import GuestbookProvider from '../components/GuestbookProvider';
---

<Layout title="Guestbook">
  <main>
    <h1>Guestbook</h1>
    <p>Leave a message in the guestbook!</p>

    <!-- Wrap the interactive React app with the Convex provider -->
    <GuestbookProvider client:load>
      <GuestbookApp client:load />
    </GuestbookProvider>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    color: var(--ctp-text);
  }

  h1 {
    color: var(--ctp-lavender);
    margin-bottom: 0.5rem;
  }

  p {
    margin-bottom: 2rem;
  }
</style>
